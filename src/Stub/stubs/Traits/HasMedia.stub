<?php

namespace {{namespace}};

use App\Casts\MediaCast;
use App\Serializers\SerializedMedia;
use Illuminate\Database\Eloquent\Model;

/**
 * @mixin Model
 */
trait HasMedia
{
    protected static function boot(): void
    {
        parent::boot();
        self::deleted(function (Model $model) {
            $mediaKeys = $model->getCasts();
            foreach ($mediaKeys as $attribute => $castValue) {
                if (str_contains($castValue, MediaCast::class)) {
                    /** @var SerializedMedia|SerializedMedia[] $media */
                    $media = $model->{$attribute};
                    if ($media !== null) {
                        if (is_array($media)) {
                            foreach ($media as $item) {
                                $item->delete();
                            }
                        } else {
                            $media->delete();
                        }
                    }
                }
            }
        });
    }
}