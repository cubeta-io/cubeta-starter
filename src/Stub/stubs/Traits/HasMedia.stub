<?php

namespace {{namespace}};

use Exception;
use Throwable;
use App\Casts\MediaCast;
use Illuminate\Support\Facades\DB;
use App\Serializers\SerializedMedia;
use Illuminate\Database\Eloquent\Model;

/**
 * @mixin Model
 */
trait HasMedia
{
    /** @var array<string, array<string, SerializedMedia>> */
    private array $pendingMedia = [];

    private static function afterCommit(callable $callback): void
    {
        if (DB::transactionLevel() > 0) {
            DB::afterCommit($callback);

            return;
        }

        $callback();
    }

    /**
     * @return array<int, string>
     */
    private static function mediaAttributes(Model $model): array
    {
        return array_keys(
            array_filter(
                $model->getCasts(),
                fn (string $cast) => str_contains($cast, MediaCast::class),
            ),
        );
    }

    /**
     * Laravel runs trait initializers on construction and unserialization, so
     * an unserialized copy never owns the pending uploads of the original.
     */
    protected function initializeHasMedia(): void
    {
        $this->pendingMedia = [];
    }

    /**
     * A clone must not delete uploads that the original model may still save.
     */
    public function __clone(): void
    {
        $this->pendingMedia = [];
    }

    /**
     * @return array<int, string>
     */
    public function pendingMediaPaths(string $attribute): array
    {
        return array_keys($this->pendingMedia[$attribute] ?? []);
    }

    /**
     * Track the uploads the attribute now holds, and delete earlier pending
     * uploads that it no longer references and that were never persisted.
     *
     * @param  array<int, SerializedMedia>  $media
     */
    public function syncPendingMedia(string $attribute, array $media): void
    {
        $keptPaths = array_map(fn (SerializedMedia $item) => $item->path(), $media);
        $persistedPaths = self::mediaPaths($this->getRawOriginal($attribute));
        $pending = [];

        foreach ($this->pendingMedia[$attribute] ?? [] as $path => $item) {
            if (in_array($path, $keptPaths, true)) {
                $pending[$path] = $item;
            } elseif (! in_array($path, $persistedPaths, true)) {
                $item->delete();
            }
        }

        foreach ($media as $item) {
            if ($item->wasRecentlyStored()) {
                $pending[$item->path()] = $item;
            }
        }

        if ($pending === []) {
            unset($this->pendingMedia[$attribute]);
        } else {
            $this->pendingMedia[$attribute] = $pending;
        }
    }

    /**
     * Pending uploads that the stored row doesn't reference yet. Inside the
     * `saved` event this is the stored row from before the save.
     *
     * @return array<string, array<string, SerializedMedia>>
     */
    private function unpersistedPendingMedia(): array
    {
        $unpersisted = [];

        foreach ($this->pendingMedia as $attribute => $media) {
            $persistedPaths = self::mediaPaths($this->getRawOriginal($attribute));

            foreach ($media as $path => $item) {
                if (! in_array($path, $persistedPaths, true)) {
                    $unpersisted[$attribute][$path] = $item;
                }
            }
        }

        return $unpersisted;
    }

    /**
     * @param  array<string, array<string, SerializedMedia>>  $media
     */
    private function forgetPendingMedia(array $media): void
    {
        foreach ($media as $attribute => $items) {
            foreach (array_keys($items) as $path) {
                unset($this->pendingMedia[$attribute][$path]);
            }

            if (empty($this->pendingMedia[$attribute])) {
                unset($this->pendingMedia[$attribute]);
            }
        }
    }

    /**
     * @param  array<string, array<string, SerializedMedia>>  $media
     */
    private function discardPendingMedia(array $media): void
    {
        $this->forgetPendingMedia($media);

        foreach ($media as $items) {
            array_walk($items, fn (SerializedMedia $item) => $item->delete());
        }
    }

    /**
     * Uploads still referenced by the stored row are kept, so saves that skip
     * model events (saveQuietly, withoutEvents, Event::fake) never lose files.
     */
    public function __destruct()
    {
        try {
            $this->discardPendingMedia($this->unpersistedPendingMedia());
        } catch (Throwable) {
            // Destructors must not hide the original exception during cleanup.
        }
    }

    /**
     * @return array<int, SerializedMedia>
     */
    private static function mediaFrom(mixed $rawValue): array
    {
        if (empty($rawValue) || ! is_string($rawValue)) {
            return [];
        }

        $decoded = json_decode($rawValue, true);

        if (! is_array($decoded)) {
            return [];
        }

        $items = SerializedMedia::isMediaArray($decoded) ? [$decoded] : $decoded;

        return array_values(
            array_map(
                fn (array $item) => new SerializedMedia($item),
                array_filter($items, fn ($item) => SerializedMedia::isMediaArray($item)),
            ),
        );
    }

    /**
     * @return array<int, string>
     */
    private static function mediaPaths(mixed $rawValue): array
    {
        return array_map(fn (SerializedMedia $media) => $media->path(), self::mediaFrom($rawValue));
    }

    /**
     * @return array<int, SerializedMedia>
     *
     * @throws Exception
     */
    private static function orphanedMedia(Model $model, string $attribute): array
    {
        $before = self::mediaFrom($model->getRawOriginal($attribute));

        if ($before === []) {
            return [];
        }

        $keptPaths = array_map(
            fn (SerializedMedia $media) => $media->path(),
            self::mediaFrom($model->getAttributes()[$attribute] ?? null),
        );

        return array_values(
            array_filter(
                $before,
                fn (SerializedMedia $media) => ! in_array($media->path(), $keptPaths, true),
            ),
        );
    }

    protected static function bootHasMedia(): void
    {
        self::saved(
            /**
             * @param Model&HasMedia $model
             *
             * @throws Exception
             */
            function (Model $model) {
                $removedMedia = [];
                $savedMedia = $model->unpersistedPendingMedia();

                foreach (self::mediaAttributes($model) as $attribute) {
                    array_push($removedMedia, ...self::orphanedMedia($model, $attribute));
                }

                if ($savedMedia !== [] && DB::transactionLevel() > 0) {
                    DB::afterRollBack(fn () => $model->discardPendingMedia($savedMedia));
                }

                self::afterCommit(function () use ($model, $removedMedia, $savedMedia) {
                    try {
                        array_walk($removedMedia, fn (SerializedMedia $media) => $media->delete());
                    } finally {
                        $model->forgetPendingMedia($savedMedia);
                    }
                });
            },
        );

        self::deleted(function (Model $model) {
            if (method_exists($model, 'isForceDeleting') && ! $model->isForceDeleting()) {
                return;
            }

            foreach (self::mediaAttributes($model) as $attribute) {
                $media = self::mediaFrom($model->getRawOriginal($attribute));

                if (! empty($media)) {
                    self::afterCommit(fn () => array_walk($media, fn (SerializedMedia $m) => $m->delete()));
                }
            }
        });
    }
}
