<?php

namespace {{namespace}};

use Exception;
use App\Http\Controllers\WebController;
use {{service_namespace}}\User\UserService;
{{imports}}

class BaseAuthController extends WebController
{
    private UserService $userService;
    private ?string $role = null;

   /**
    * @throws Exception
    */
    public function __construct()
    {
        $this->userService = UserService::make();
        $this->userService->setGuard("web");
        $this->relations = [];
    }

    public function roleHook(string $role)
    {
        $this->role = $role;
    }

    public function login({{login_class}} ${{request_var}})
    {
        $user = $this->userService->login(${{request_var}}->{{validated_call}}, $this->role, $this->relations);
        if ($user) {
            return redirect()->route('{{user_details_route}}');
        } else {
            session()->flash('error', trans('site.credentials_not_match_records'));
            return redirect()->back();
        }
    }

    public function register({{register_class}} ${{request_var}})
    {
        $user = $this->userService->register(${{request_var}}->{{validated_call}}, $this->role , $this->relations);
        if ($user) {
            return redirect()->route('{{user_details_route}}');
        } else {
            session()->flash('error', trans('site.something_went_wrong'));
            return redirect()->back();
        }
    }

    public function updateUserDetails({{update_user_class}} ${{request_var}})
    {
        $user = $this->userService->updateUserDetails(${{request_var}}->{{validated_call}}, $this->role , $this->relations);

        if ($user) {
            return redirect()->route('{{user_details_route}}');
        } else {
            session()->flash('error', trans('site.something_went_wrong'));
            return redirect()->back();
        }
    }

    public function userDetails()
    {
        $user = $this->userService->userDetails($this->role ,$this->relations);

        if ($user) {
            return view('{{user_details_page_name}}', compact('user'));
        } else {
            session()->flash('error', trans('site.something_went_wrong'));
            return redirect()->back();
        }
    }

    public function requestResetPassword({{request_reset_class}} ${{request_var}})
    {
        $result = $this->userService->passwordResetRequest(${{request_var}}->email);
        if ($result) {
            return view('{{reset_password_code_form_page_name}}');
        } else {
            session()->flash('error', trans('site.something_went_wrong'));
            return redirect()->back();
        }
    }

    public function validateResetPasswordCode({{check_reset_class}} ${{request_var}})
    {
        return redirect()->route('{{password_reset_page_route}}');
    }

    public function resetPassword({{reset_class}} ${{request_var}})
    {
        $data = ${{request_var}}->{{validated_call}};
        $result = $this->userService->passwordReset($data['reset_password_code'], $data['password']);

        if ($result) {
            session()->flash('success', trans('site.password_changed_successfully'));
            return redirect()->route('{{login_page_route}}');
        } else {
            session()->flash('error', trans('site.credentials_not_match_records'));
            return redirect()->back();
        }
    }

    public function logout()
    {
        $this->userService->logout();
        return redirect()->route("{{login_page_route}}");
    }
}
