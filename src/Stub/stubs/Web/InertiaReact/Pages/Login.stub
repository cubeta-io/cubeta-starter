import {
    Card,
    CardContent,
    CardDescription,
    CardHeader,
    CardTitle,
} from "@/components/ui/card";
import { Field, FieldDescription, FieldGroup } from "@/components/ui/field";
import Form from "@/components/form/form";
import { Link, useForm } from "@inertiajs/react";
import React from "react";
import Input from "@/components/form/fields/input";
import { useTranslation } from "@/hooks/use-translation";

function Login() {
    const { t } = useTranslation();
    const { post, setData, processing } = useForm<{
        email: string;
        password: string;
    }>();

    const onSubmit = (e: React.SubmitEvent<HTMLFormElement>) => {
        e.preventDefault();
        post(route("{{login_route}}"));
    };
    return (
        <Card>
            <CardHeader>
                <CardTitle>{t("dashboard.auth.login_title")}</CardTitle>
                <CardDescription>
                    {t("dashboard.auth.login_description")}
                </CardDescription>
            </CardHeader>
            <CardContent>
                <Form
                    onSubmit={onSubmit}
                    buttonText={t("dashboard.auth.login")}
                    processing={processing}
                    backButton={false}
                >
                    <FieldGroup>
                        <Input
                            name={"email"}
                            label={t("dashboard.auth.email")}
                            type={"text"}
                            onChange={(e) => setData("email", e.target.value)}
                            required={true}
                        />

                        <Input
                            name={"password"}
                            label={t("dashboard.auth.password")}
                            type={"password"}
                            onChange={(e) =>
                                setData("password", e.target.value)
                            }
                            required={true}
                        />
                        <Field>
                            <FieldDescription>
                                {t("dashboard.auth.not_registered")} {" "}
                                <Link href={route("{{register_page_route}}")}>
                                    {t("dashboard.auth.sign_up")}
                                </Link>
                            </FieldDescription>

                            <FieldDescription>
                                {t("dashboard.auth.forgot_password")} {" "}
                                <Link
                                    href={route(
                                        "{{password_reset_request_page_route}}",
                                    )}
                                >
                                    {t("dashboard.auth.try_password_reset")}
                                </Link>
                            </FieldDescription>
                        </Field>
                    </FieldGroup>
                </Form>
            </CardContent>
        </Card>
    );
}

export default Login;
