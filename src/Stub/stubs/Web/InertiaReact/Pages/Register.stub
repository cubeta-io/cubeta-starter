import {
    Card,
    CardContent,
    CardDescription,
    CardHeader,
    CardTitle,
} from "@/components/ui/card";
import { Field, FieldDescription, FieldGroup } from "@/components/ui/field";
import { Link, useForm } from "@inertiajs/react";
import React from "react";
import Form from "@/components/form/form";
import Input from "@/components/form/fields/input";
import { useTranslation } from "@/hooks/use-translation";

function Register() {
    const { t } = useTranslation();
    const { post, setData, processing } = useForm<{
        first_name: string;
        last_name: string;
        email: string;
        password: string;
        password_confirmation: string;
    }>();

    const onSubmit = (e: React.SubmitEvent<HTMLFormElement>) => {
        e.preventDefault();
        post(route("{{register_route}}"));
    };
    return (
        <Card>
            <CardHeader>
                <CardTitle>{t("dashboard.auth.register_title")}</CardTitle>
                <CardDescription>
                    {t("dashboard.auth.register_description")}
                </CardDescription>
            </CardHeader>
            <CardContent>
                <Form
                    onSubmit={onSubmit}
                    processing={processing}
                    buttonText={t("dashboard.auth.register")}
                    backButton={false}
                >
                    <FieldGroup>
                        <FieldGroup
                            className={
                                "flex items-center justify-between flex-row"
                            }
                        >
                            <Input
                                name="first_name"
                                onChange={(e) =>
                                    setData("first_name", e.target.value)
                                }
                                label={t("dashboard.auth.first_name")}
                                required={true}
                                type="text"
                            />
                            <Input
                                name="last_name"
                                onChange={(e) =>
                                    setData("last_name", e.target.value)
                                }
                                label={t("dashboard.auth.last_name")}
                                required={true}
                                type="text"
                            />
                        </FieldGroup>
                        <Input
                            name="email"
                            onChange={(e) => setData("email", e.target.value)}
                            label={t("dashboard.auth.email")}
                            required={true}
                            type="email"
                        />

                        <Input
                            name="password"
                            onChange={(e) =>
                                setData("password", e.target.value)
                            }
                            label={t("dashboard.auth.password")}
                            required={true}
                            type="password"
                        />
                        <Input
                            name="password_confirmation"
                            onChange={(e) =>
                                setData("password_confirmation", e.target.value)
                            }
                            label={t("dashboard.auth.confirm_password")}
                            required={true}
                            type="password"
                        />
                        <Field>
                            <FieldDescription>
                                {t("dashboard.auth.already_registered")} {" "}
                                <Link href={route("{{login_page_route}}")}>
                                    {t("dashboard.auth.sign_in")}
                                </Link>
                            </FieldDescription>
                        </Field>
                    </FieldGroup>
                </Form>
            </CardContent>
        </Card>
    );
}

export default Register;
