import Form from "@/components/form/form";
import { useForm } from "@inertiajs/react";
import React from "react";
import {
    Card,
    CardContent,
    CardDescription,
    CardHeader,
    CardTitle,
} from "@/components/ui/card";
import { FieldGroup } from "@/components/ui/field";
import Input from "@/components/form/fields/input";
import { useTranslation } from "@/hooks/use-translation";

const ResetPassword = () => {
    const { t } = useTranslation();
    const { post, setData, processing } = useForm<{
        reset_password_code: string;
        password: string;
        password_confirmation: string;
    }>();

    const onSubmit = (e: React.SubmitEvent<HTMLFormElement>) => {
        e.preventDefault();
        post(route("{{password_reset_route}}"));
    };
    return (
        <Card>
            <CardHeader>
                <CardTitle>
                    {t("dashboard.auth.check_email")}
                </CardTitle>
                <CardDescription>
                    {t("dashboard.auth.reset_code_description")}
                </CardDescription>
            </CardHeader>
            <CardContent>
                <Form
                    onSubmit={onSubmit}
                    processing={processing}
                    backButton={false}
                    buttonText={t("dashboard.auth.reset_password")}
                >
                    <FieldGroup>
                        <Input
                            label={t("dashboard.auth.reset_code")}
                            name="reset_password_code"
                            type="text"
                            onChange={(e) => {
                                setData("reset_password_code", e.target.value);
                            }}
                            required={true}
                        />

                        <Input
                            label={t("dashboard.auth.new_password")}
                            name="password"
                            type="password"
                            onChange={(e) => {
                                setData("password", e.target.value);
                            }}
                            required={true}
                        />

                        <Input
                            label={t("dashboard.auth.confirm_password")}
                            name="password_confirmation"
                            type="password"
                            onChange={(e) => {
                                setData(
                                    "password_confirmation",
                                    e.target.value,
                                );
                            }}
                            required={true}
                        />
                    </FieldGroup>
                </Form>
            </CardContent>
        </Card>
    );
};

export default ResetPassword;
