import Form from "@/components/form/form";
import { useForm } from "@inertiajs/react";
import React from "react";
import {
    Card,
    CardContent,
    CardDescription,
    CardHeader,
    CardTitle,
} from "@/components/ui/card";
import { FieldGroup } from "@/components/ui/field";
import Input from "@/components/form/fields/input";
import { useTranslation } from "@/hooks/use-translation";

const ResetPasswordCodeForm = () => {
    const { t } = useTranslation();
    const { post, setData, processing } = useForm<{
        reset_password_code: string;
    }>();

    const onSubmit = (e: React.SubmitEvent<HTMLFormElement>) => {
        e.preventDefault();
        post(route("{{validate_reset_code_route}}"));
    };
    return (
        <Card>
            <CardHeader>
                <CardTitle>
                    {t("dashboard.auth.check_email")}
                </CardTitle>
                <CardDescription>
                    {t("dashboard.auth.reset_code_description")}
                </CardDescription>
            </CardHeader>
            <CardContent>
                <Form
                    onSubmit={onSubmit}
                    processing={processing}
                    backButton={false}
                    buttonText={t("dashboard.auth.submit_code")}
                >
                    <FieldGroup>
                        <Input
                            label={t("dashboard.auth.reset_code")}
                            name={"reset_password_code"}
                            required={true}
                            onChange={(e) => {
                                setData("reset_password_code", e.target.value);
                            }}
                            type="text"
                        />
                    </FieldGroup>
                </Form>
            </CardContent>
        </Card>
    );
};

export default ResetPasswordCodeForm;
