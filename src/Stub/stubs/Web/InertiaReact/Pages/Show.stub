import { Button } from "@/components/ui/button";
import PageCard from "@/components/ui/page-card";
import { Link } from "@inertiajs/react";
import { FieldGroup } from "@/components/ui/field";
import { useTranslation } from "@/hooks/use-translation";
{{imports}}

const Show = ({ {{model_variable}} }: { {{model_variable}}: {{model_name}} }) => {
    const { t } = useTranslation();
    return (
        <PageCard
            title={t("dashboard.titles.details", { model: t("models.{{model_name}}.singular") })}
            actions={
                <Link href={route("{{edit_route_name}}" , {{model_variable}}.id)}>
                    <Button>{t("dashboard.actions.edit")}</Button>
                </Link>
            }
        >
            <FieldGroup>
                <div className="gap-5 grid grid-cols-1 md:grid-cols-2">
                    {{small_fields}}
                </div>

                {{big_fields}}
            </FieldGroup>
        </PageCard>
    );
};

export default Show;
