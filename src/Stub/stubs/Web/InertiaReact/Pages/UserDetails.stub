import Form from "@/components/form/form";
import Input from "@/components/form/fields/input";
import PageCard from "@/components/ui/page-card";
import User from "@/models/user";
import { useForm } from "@inertiajs/react";
import { Tabs, TabsContent, TabsList, TabsTrigger } from "@/components/ui/tabs";
import React from "react";
import {
    Field,
    FieldDescription,
    FieldGroup,
    FieldLabel,
} from "@/components/ui/field";
import { useTranslation } from "@/hooks/use-translation";

const UserDetails = ({ user }: { user: User }) => {
    const { t } = useTranslation();
    return (
        <PageCard title={t("dashboard.titles.account_details")}>
            <Tabs defaultValue={"overview"}>
                <TabsList className={"w-full"}>
                    <TabsTrigger value={"overview"}>{t("dashboard.auth.overview")}</TabsTrigger>
                    <TabsTrigger value={"edit_profile"}>
                        {t("dashboard.actions.edit")} {t("dashboard.profile")}
                    </TabsTrigger>
                </TabsList>
                <TabsContent value={"overview"}>
                    <UserOverview user={user} />
                </TabsContent>
                <TabsContent value={"edit_profile"}>
                    <EditProfile user={user} />
                </TabsContent>
            </Tabs>
        </PageCard>
    );
};

export default UserDetails;

const UserOverview = ({ user }: { user: User }) => {
    const { t } = useTranslation();
    return (
        <div className="my-5 grid grid-cols-1 md:grid-cols-2 gap-3">
            <Field orientation={"horizontal"}>
                <FieldLabel>{t("dashboard.auth.full_name")}</FieldLabel>
                <FieldDescription>
                    {user.first_name} {user.last_name}
                </FieldDescription>
            </Field>

            <Field orientation={"horizontal"}>
                <FieldLabel>{t("dashboard.auth.email")}</FieldLabel>
                <FieldDescription>{user.email}</FieldDescription>
            </Field>
        </div>
    );
};

const EditProfile = ({ user }: { user: User }) => {
    const { t } = useTranslation();
    const { put, setData, processing } = useForm<{
        first_name?: string;
        last_name?: string;
        email?: string;
        password?: string;
        password_confirmation?: string;
        _method: "POST" | "PUT";
    }>({
        ...user,
        _method: "PUT",
    });

    const onSubmit = (e: React.SubmitEvent<HTMLFormElement>) => {
        e.preventDefault();
        put(route("{{update_user_data_route}}"));
    };

    return (
        <Form onSubmit={onSubmit} processing={processing} backButton={false}>
            <FieldGroup>
                <FieldGroup className={"flex flex-row items-center"}>
                    <Input
                        name="first_name"
                        type="text"
                        label={t("dashboard.auth.first_name")}
                        onChange={(e) => {
                            setData("first_name", e.target.value);
                        }}
                        defaultValue={user?.first_name}
                    />

                    <Input
                        name="last_name"
                        type="text"
                        label={t("dashboard.auth.last_name")}
                        onChange={(e) => {
                            setData("last_name", e.target.value);
                        }}
                        defaultValue={user?.last_name}
                    />
                </FieldGroup>

                <Input
                    name="email"
                    type="email"
                    label={t("dashboard.auth.email")}
                    onChange={(e) => {
                        setData("email", e.target.value);
                    }}
                    defaultValue={user?.email}
                />

                <Input
                    name="password"
                    label={t("dashboard.auth.new_password")}
                    type="password"
                    onChange={(e) => {
                        setData(
                            "password",
                            e.target.value.length <= 0
                                ? undefined
                                : e.target.value,
                        );
                    }}
                />

                <Input
                    name="password_confirmation"
                    label={t("dashboard.auth.confirm_password")}
                    type="password"
                    onChange={(e) => {
                        setData(
                            "password_confirmation",
                            e.target.value.length <= 0
                                ? undefined
                                : e.target.value,
                        );
                    }}
                />
            </FieldGroup>
        </Form>
    );
};
